+    location = [plt.xlim()[0] + (plt.xlim()[1] - plt.xlim()[0]) * .05,
+                plt.ylim()[1] - ((plt.ylim()[1] - plt.ylim()[0]) * (0.05 + (height_scale * .04)))]
+
+    ax.add_patch(Rectangle(location, width, height, ec=(0, 0, 0, 1), fc=(1, 1, 1, 1), lw=height_scale))
